<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <UserSecretsId>recruit-api</UserSecretsId>
    <RootNamespace>SFA.DAS.Recruit.Api</RootNamespace>
    <AssemblyName>SFA.DAS.Recruit.Api</AssemblyName>
    <AspNetCoreHostingModel>OutOfProcess</AspNetCoreHostingModel>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SFA.DAS.Recruit.Api.UnitTests" />
    <InternalsVisibleTo Include="SFA.DAS.Recruit.Api.IntegrationTests" />
  </ItemGroup>

  <ItemGroup>

    <PackageReference Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />

    <PackageReference Include="Azure.Storage.Blobs" Version="12.30.2" />

    <PackageReference Include="FluentValidation" Version="12.2.0" />

    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />

    <PackageReference Include="HotChocolate.AspNetCore" Version="16.7.7" />

    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.7.7" />

    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.7.7" />

    <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.2.0" />

    <PackageReference Include="Microsoft.AspNetCore.JsonPatch.SystemTextJson" Version="10.0.15" />

    <PackageReference Include="Microsoft.OpenApi" Version="2.13.1" />

    <PackageReference Include="OpenTelemetry.Api" Version="1.21.0" />
    <PackageReference Include="SFA.DAS.Configuration.AzureTableStorage" Version="17.1.165" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.15" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.15" />
    <PackageReference Include="SFA.DAS.Api.Common" Version="17.1.196" />
    
    <PackageReference Include="SFA.DAS.Encoding" Version="1.1.94" />
    <PackageReference Include="SFA.DAS.InputValidation" Version="17.1.100" />
    
    <PackageReference Include="SFA.DAS.NServiceBus" Version="17.0.49" />

    <PackageReference Include="SFA.DAS.VacancyServices.Wage" Version="1.0.45" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.15" />
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.15">
      <GeneratePathProperty>true</GeneratePathProperty>
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Scalar.AspNetCore" Version="3.3.0" />
    <PackageReference Include="HtmlSanitizer" Version="11.0.26" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Recruit.Api.Data\Recruit.Api.Data.csproj" />
    <ProjectReference Include="..\Recruit.Api.Domain\Recruit.Api.Domain.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="appsettings.Development.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
    <Content Update="appsettings.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <PropertyGroup>
    <OpenApiGenerateDocumentsOnBuild>true</OpenApiGenerateDocumentsOnBuild>
    <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)</OpenApiDocumentsDirectory>
  </PropertyGroup>
</Project>
