<Project Sdk="MsBuild.Sdk.SqlProj/3.2.0">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <DSP>Microsoft.Data.Tools.Schema.Sql.SqlAureV12DatabaseSchemaProvider</DSP>
    <SqlServerVersion>SqlAzure</SqlServerVersion>
  </PropertyGroup>
  <ItemGroup>
    <None Include="Database.publish.xml">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <!-- Remove from auto-include so SDK doesn't try to model it -->
    <Content Remove="Scripts\PostDeployment\RecalibrateSequence.sql" />
    <!-- Re-add explicitly as a PostDeploy script -->
    <PostDeploy Include="Scripts\PostDeployment\RecalibrateSequence.sql" />
  </ItemGroup>
</Project>